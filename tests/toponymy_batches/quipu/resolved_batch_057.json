        {
          "date": "1659.11.6",
          "date_source_note": "Founded on 6 November 1659 as San Pedro in the Norte antioqueño (former Nutabe indigenous territory); erected as a parish in 1757 and as a municipality of Antioquia in 1813. Although the venerated image of the Señor de los Milagros arrived around 1774 and parish priest Fermín de Hoyos (with Padre Marianito) began building the present Basilica in 1874, the municipality remained officially named San Pedro until 2001.",
          "name": "San Pedro"
        },
        {
          "date": "2001.12.12",
          "date_source_note": "Officially renamed San Pedro de los Milagros on 12 December 2001 by Asamblea Departamental de Antioquia Ordenanza N.° 29 de 2001 ('Por medio de la cual se le adiciona el nombre a un municipio del Departamento de Antioquia'), formalising the long-standing devotional title.",
          "name": "San Pedro de los Milagros"
        }
