  // Legacy alias kept for compatibility with existing scripts reading `title_limits`
  title_limits: {
    max_chapter_title_chars: 72,
    max_chapter_title_words: 10,
    max_subtitle_chars: 90,
    root_title: "Studies on Population"
  },

  suspicious_toponym_patterns: {
    religious_monument_regexes: [
      "^wat\\s+",
      "^candi\\s+",
      "^prasat\\s+",
      "^pura\\s+",
      "^stupa\\s+",
      "^mazar\\s+",
      "^caravanserai\\s+",
      "\\b(?:temple|shrine|pagoda|monastery|mosque|mausoleum|tomb|basilica|cathedral|abbey|church|chapel|sanctuary|stupa|jinja|taisha|hachimangu|guangfu\\s+temple|kofun\\s+tomb)\\b",
      "[a-z]+-(?:ji|dera|jinja|taisha|sa|am)$"
    ],
    admin_unit_suffix_regexes: [
      "-(?:shi|si|gun|ken|fu|do|cho|machi|mura|gu|dong|myeon|eup)$",
      "\\b(?:prefecture|oblast|krai|raion|uyezd|volost|guberniya|province|district|municipality|regency|kabupaten|kecamatan|amphoe|changwat|wilayah|governorate|vilayet|sanjak|tehsil|taluka|upazila|comarca|departamento|canton|county|township|parish)\\s*$"
    ],
    allowlist: [
      "watford", "waterford", "waterloo", "temple", "templeton", "temple hall", "christchurch",
      "christ church", "christ church nichola town", "church corner", "indian church",
      "abbeyfeale", "abbeyleix", "chapel hill", "church hill", "falls church",
      "whitechurch", "whitchurch", "banteay meanchey", "kampong cham",
      "nakhon si thammarat", "phra nakhon si ayutthaya", "dazaifu", "kofu",
      "hofu", "beppu", "kanazawa", "sendai", "sapporo", "nagasaki", "fukuoka",
      "kagoshima", "naha", "mazar-i-sharif", "mazar-e-sharif", "tombouctou",
      "timbuktu", "saint-denis", "sanctuary point", "savigny-le-temple"
    ]
  },

